---
import { Image } from "astro:assets";
import { company } from "@/data/site";
import logo from "@/assets/images/logo.png";
import {
  LOGO_ALT,
  LOGO_MARK_BASE,
  LOGO_SIZES,
  LOGO_WORDMARK_BOTTOM,
  LOGO_WORDMARK_TOP,
  type LogoSize,
} from "@/components/logo-config";

/**
 * Logo lockup for static sections (Header, Footer). Ships 0 JS apart from the
 * shared click-spin script at the bottom.
 *
 * Every dimension, class and string comes from logo-config.ts, which the React
 * twin (components/react/Logo.tsx) also imports — see that file for why the
 * markup exists twice.
 *
 * Color of the wordmark is NOT set here: .logo-text / .logo-text-sub in
 * global.css own it, so the header's dark-hero / on-light / is-scrolled states
 * can recolor it the same way they recolor .header-link.
 */
interface Props {
  /** "lg" for the fixed header, "sm" for the footer. */
  size?: LogoSize;
  /** Header hides the wordmark below md to leave room for the mobile menu. */
  hideTextOnMobile?: boolean;
}
const { size = "lg", hideTextOnMobile = false } = Astro.props;
const s = LOGO_SIZES[size];
---

<a
  href="/"
  class="logo-link group flex shrink-0 items-center"
  aria-label={company.legalName}
>
  <Image
    src={logo}
    alt={LOGO_ALT}
    width={128}
    height={128}
    class:list={[LOGO_MARK_BASE, s.mark]}
  />
  <span
    class:list={[
      s.gap,
      "flex-col font-display leading-none",
      hideTextOnMobile ? "hidden md:flex" : "flex",
    ]}
  >
    <span
      class:list={["logo-text font-extrabold uppercase tracking-tight", s.title]}
    >
      {LOGO_WORDMARK_TOP}
    </span>
    <span
      class:list={["logo-text-sub mt-0.5 font-semibold uppercase", s.sub]}
    >
      {LOGO_WORDMARK_BOTTOM}
    </span>
  </span>
</a>

<script>
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  document.querySelectorAll(".logo-link").forEach((link) => {
    const mark = link.querySelector(".logo-mark");
    link.addEventListener("click", (e) => {
      if (reduceMotion || !mark) return;

      mark.classList.remove("logo-spin");
      // force reflow so the animation restarts on repeated clicks
      void mark.offsetWidth;
      mark.classList.add("logo-spin");

      if (window.location.pathname === "/") {
        e.preventDefault();
      }
    });
  });
</script>
