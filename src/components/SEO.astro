---
import { company, serviceAreas } from "@/data/site";

/**
 * All <head> SEO output: meta, Open Graph, Twitter, and a single connected
 * JSON-LD @graph.
 *
 * Why one @graph instead of several <script> blocks: nodes get stable @ids
 * (#organization, #website, #webpage) and reference each other, so Google
 * resolves them into one entity for the site rather than re-reading an
 * unconnected LocalBusiness copy on all 25 URLs. Page-specific nodes (Service,
 * FAQPage, …) come in via the `schema` prop and are appended to the same graph.
 *
 * Deliberately NOT here: aggregateRating / Review on the business node. Google
 * ignores self-serving reviews (reviews about a business hosted on that
 * business's own site) for LocalBusiness and Organization, and marking them up
 * anyway risks a structured-data manual action. Stars come from Google Business
 * Profile reviews, not from this file.
 */

export interface Crumb {
  name: string;
  /** absolute path, e.g. "/hizmetler" — omit on the current (last) crumb */
  url?: string;
}

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  /** project case studies are "article"; everything else "website" */
  ogType?: "website" | "article";
  breadcrumbs?: Crumb[];
  /** extra JSON-LD nodes merged into the @graph */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  image = "/images/og.jpg",
  noindex = false,
  ogType = "website",
  breadcrumbs = [],
  schema = [],
} = Astro.props;

const base = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, base).href;
const ogImage = new URL(image, base).href;
const origin = base.href.replace(/\/$/, "");

const ORG_ID = `${origin}/#organization`;
const SITE_ID = `${origin}/#website`;
const PAGE_ID = `${canonical}#webpage`;

/** Districts + neighbouring provinces we take work in — drives local relevance. */
const areaServed = [
  {
    "@type": "AdministrativeArea",
    name: `${serviceAreas.primary} ili`,
  },
  ...serviceAreas.districts.map((d) => ({ "@type": "City", name: d })),
  ...serviceAreas.cities
    .filter((c) => c !== serviceAreas.primary)
    .map((c) => ({ "@type": "City", name: c })),
];

const organization = {
  "@type": ["GeneralContractor", "LocalBusiness"],
  "@id": ORG_ID,
  name: company.legalName,
  alternateName: company.name,
  url: `${origin}/`,
  logo: {
    "@type": "ImageObject",
    "@id": `${origin}/#logo`,
    url: new URL("/web-app-manifest-512x512.png", base).href,
    width: 512,
    height: 512,
    caption: company.legalName,
  },
  image: ogImage,
  telephone: company.phone,
  email: company.email,
  foundingDate: company.foundingYear,
  founder: {
    "@type": "Person",
    name: company.owner,
    jobTitle: company.ownerRole,
  },
  priceRange: company.priceRange,
  currenciesAccepted: "TRY",
  address: {
    "@type": "PostalAddress",
    streetAddress: company.addressLong,
    addressLocality: company.addressLocality,
    addressRegion: company.addressRegion,
    postalCode: company.postalCode,
    addressCountry: "TR",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: company.geo.lat,
    longitude: company.geo.lng,
  },
  hasMap: company.mapsLink,
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: company.openingHours.days,
      opens: company.openingHours.opens,
      closes: company.openingHours.closes,
    },
  ],
  areaServed,
  sameAs: [company.instagram],
  knowsLanguage: ["tr"],
};

const website = {
  "@type": "WebSite",
  "@id": SITE_ID,
  url: `${origin}/`,
  name: company.name,
  description,
  publisher: { "@id": ORG_ID },
  inLanguage: "tr-TR",
};

const webPage = {
  "@type": "WebPage",
  "@id": PAGE_ID,
  url: canonical,
  name: title,
  description,
  isPartOf: { "@id": SITE_ID },
  about: { "@id": ORG_ID },
  primaryImageOfPage: { "@type": "ImageObject", url: ogImage },
  inLanguage: "tr-TR",
  ...(breadcrumbs.length > 1
    ? { breadcrumb: { "@id": `${canonical}#breadcrumb` } }
    : {}),
};

const breadcrumbList =
  breadcrumbs.length > 1
    ? [
        {
          "@type": "BreadcrumbList",
          "@id": `${canonical}#breadcrumb`,
          itemListElement: breadcrumbs.map((c, i) => ({
            "@type": "ListItem",
            position: i + 1,
            name: c.name,
            ...(c.url ? { item: new URL(c.url, base).href } : {}),
          })),
        },
      ]
    : [];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [organization, website, webPage, ...breadcrumbList, ...schema],
};
---

<!-- Primary -->
<title>{title}</title>
<meta name="description" content={description} />
{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
  )
}
<link rel="canonical" href={canonical} />
<meta name="geo.region" content="TR-59" />
<meta name="geo.placename" content={company.addressLocality} />
<meta
  name="geo.position"
  content={`${company.geo.lat};${company.geo.lng}`}
/>
<meta name="ICBM" content={`${company.geo.lat}, ${company.geo.lng}`} />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={company.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<!-- Matches public/images/og.jpg exactly. If that file is ever re-exported,
     update these two numbers or previews will reserve the wrong box. -->
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="800" />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content="tr_TR" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={title} />

{
  !noindex && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )
}
