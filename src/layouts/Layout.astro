---
import "@/styles/global.css";
import SEO from "@/components/SEO.astro";
import type { Crumb } from "@/components/SEO.astro";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  /** dev/preview pages: emit robots noindex and skip JSON-LD */
  noindex?: boolean;
  /** project case studies pass "article"; everything else stays "website" */
  ogType?: "website" | "article";
  /** feeds BreadcrumbList JSON-LD — keep in sync with the visible crumbs */
  breadcrumbs?: Crumb[];
  /** page-specific JSON-LD nodes (Service, FAQPage, …) merged into the @graph */
  schema?: Record<string, unknown>[];
}

const {
  title = "Tekirdağ Cephe Giydirme ve Alüminyum Doğrama | Yılmaz Alüminyum",
  description = "Tekirdağ'da cam cephe, kompozit panel kaplama, cam balkon ve alüminyum doğrama. 20+ yıllık tecrübe, ücretsiz keşif. Süleymanpaşa, Çorlu ve Çerkezköy'e hizmet.",
  lang = "tr",
  noindex = false,
  ogType = "website",
  breadcrumbs = [],
  schema = [],
} = Astro.props;
---

<!doctype html>
<!-- No `scroll-smooth` here: CSS scroll-behavior fights Lenis (both animate the
     same scroll position), causing stutter and white overscroll flashes. -->
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicons. The generator's favicon.svg was a 3.9 MB base64 raster in an
         <svg> wrapper, not a real vector — dropped in favour of the ICO/PNG set. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1a283b" />
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts: Manrope (display) + Inter (body). Icons are inline lucide SVG. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <SEO
      title={title}
      description={description}
      noindex={noindex}
      ogType={ogType}
      breadcrumbs={breadcrumbs}
      schema={schema}
    />
  </head>
  <body>
    <slot />

    <!-- Smooth scroll (Lenis) + scroll-reveal observer. Tiny, no framework. -->
    <script>
      import Lenis from "lenis";

      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      if (!reduce) {
        const lenis = new Lenis({ duration: 1.1, smoothWheel: true });
        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        // anchor links -> smooth scroll via Lenis
        document.querySelectorAll('a[href^="#"]').forEach((a) => {
          a.addEventListener("click", (e) => {
            const id = a.getAttribute("href");
            if (id && id.length > 1) {
              const el = document.querySelector(id);
              if (el) {
                e.preventDefault();
                lenis.scrollTo(el as HTMLElement, { offset: -110 });
              }
            }
          });
        });
      }

      // Scroll reveal
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("active");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 },
      );
      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));

      // Transparent header -> frosted on scroll past the hero
      const navEl = document.getElementById("main-nav");
      if (navEl) {
        const onScroll = () => {
          const scrolled = window.scrollY > 50;
          navEl.classList.toggle("is-scrolled", scrolled);
          navEl.classList.toggle("shadow-sm", scrolled);
        };
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      }
    </script>
  </body>
</html>
